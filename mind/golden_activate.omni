// ==============================================================================
// GOLDEN ACTIVATE — Omni-Mind v0.1 activate + confidence golden
// ==============================================================================
//
// Activates the memory matching a cue and returns the packed activation
// result: (value + 100) * 10 + (confidence + 1).
//
//   main(cue) -> packed activation result.
//
//   cue == 1 (morning) -> memory 0, value 42, confidence +1 -> 1422.
//   cue == 2 (evening) -> memory 1, value 99, confidence +1 -> 1992.
//   any other cue      -> no memory matches, value 0, confidence 0 -> 1001.
//
// The confidence-0 case is the point of this golden: a cue with no
// matching memory returns confidence 0 (unknown), not a forced guess.
// The caller must gather more information instead of acting on it.
//
// Expected (run with: omnic run mind/golden_activate.omni <cue>):
//   main(1) -> 1422  (memory 0, value 42, conf +1)
//   main(2) -> 1992  (memory 1, value 99, conf +1)
//   main(3) -> 1001  (no memory, value 0, conf 0)
//   main(0) -> 1001  (no memory, value 0, conf 0)
// ==============================================================================

include "std/math.omni";
include "std/trit.omni";
include "memory.omni";
include "activate.omni";

#[strict]
#[cap(AI)]
#[step_budget(100000)]
#[mem_budget(8192)]
fn main(cue: i64) -> i64 {
    // Activate the memory matching cue. Return the packed result
    // (value + 100) * 10 + (confidence + 1) so the confidence is visible.
    return activate(cue);
}
