// ==============================================================================
// PERCEPTRON — a learning machine in Pure Omni
// ==============================================================================
//
// A single perceptron that LEARNS. This is the atom of neural networks:
// one neuron with one weight, a sign activation, and the perceptron
// learning rule. Given an input, a target, and the current weight, it
// predicts, compares, and updates the weight when it is wrong. Call it
// repeatedly with new examples and the weight converges to a classifier.
//
//   main(x, target, w) -> (w_new + 100) * 3 + (y + 1)
//
//   x      : the input, clamped to [-10, 10].
//   target : the desired output, -1 or +1.
//   w      : the current weight, clamped to [-99, 99].
//
//   y     : the prediction, -1, 0, or +1 (0 means undecided, when w*x = 0).
//   w_new : the updated weight. If the prediction was right, it is
//           unchanged. If it was wrong, it moves by the perceptron rule:
//           w_new = clamp(w + target * x, -99, 99).
//
// The update is selected with egate + std_trit_mux: egate(y - target)
// is 0 when the prediction matches (no update) and nonzero when it does
// not (update). The caller splits the answer with / and %.
//
// Why this matters: Omni exists so AI can work faster and learn. A
// perceptron is the smallest thing that learns — and it runs here, in
// the language itself, with no host help.
//
// Examples (run with: omnic run perceptron.omni <x> <target> <w>):
//   main(2, 1, 0)   -> 307  (undecided at w=0, learns w=2)
//   main(2, 1, 5)   -> 317  (already right, w stays 5)
//   main(3, -1, 4)  -> 305  (wrong, w drops from 4 to 1)
//   main(-2, -1, 3) -> 309  (already right, w stays 3)
//   main(5, 1, 90)  -> 572  (already right, w stays 90)
// ==============================================================================

include "std/math.omni";
include "std/trit.omni";

#[strict]
#[cap(AI)]
#[step_budget(24000)]
#[mem_budget(8192)]
fn main(x: i64, target: i64, w: i64) -> i64 {
    let inp: i64 = std_clamp(x, -10, 10);
    let tgt: i64 = std_clamp(target, -1, 1);
    let wt: i64 = std_clamp(w, -99, 99);
    // The activation: sign(w * x). egate gives -1, 0, or +1.
    let s: i64 = wt * inp;
    let y: trit = egate(s);
    // The perceptron update, computed but only applied when wrong.
    let w_upd: i64 = std_clamp(wt + tgt * inp, -99, 99);
    // egate(y - target) is 0 when the prediction matches, nonzero
    // when it does not. Select the weight accordingly.
    let g: trit = egate(y - tgt);
    let w_new: i64 = std_trit_mux(g, w_upd, wt, w_upd);
    // Pack the new weight and the prediction into one i64.
    return (w_new + 100) * 3 + (y + 1);
}
