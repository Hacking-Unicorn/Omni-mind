// ==============================================================================
// TRIT PACK — pack three balanced trits into one number in Pure Omni
// ==============================================================================
//
// Pack three balanced-ternary digits (-1, 0, +1) into a single i64 using
// base-3 positional encoding. This is the same packing @PACK5 uses, done
// by hand with arithmetic instead of the pack5_bytes builtin (which still
// needs an array literal and does not run from disk yet).
//
//   main(t0, t1, t2) -> (t0+1)*9 + (t1+1)*3 + (t2+1)
//
// Each trit is clamped to [-1, 1] first, so out-of-range inputs fold to
// the nearest legal trit instead of breaking the packing. The result is
// 0..26. The caller unpacks with / and %.
//
// NOTE: this packs three trits, not five. A five-trit version needs five
// arguments, and `run` currently drops every argument past the third
// (they arrive as 0) — a real toolchain bug found while writing this
// program, reported separately. Once that is fixed, extend this to five
// trits for a full byte (0..242).
//
// Examples (run with: omnic run trit_pack.omni <t0> <t1> <t2>):
//   main(1, 1, 1)    -> 26  (all +1)
//   main(-1, -1, -1) -> 0   (all -1)
//   main(0, 0, 0)    -> 13  (all 0, the midpoint)
//   main(1, 0, -1)   -> 21
//   main(5, -5, 0)   -> 19  (clamped to 1, -1, 0)
// ==============================================================================

include "std/math.omni";

#[strict]
#[cap(AI)]
#[step_budget(24000)]
#[mem_budget(8192)]
fn main(t0: i64, t1: i64, t2: i64) -> i64 {
    // Clamp each input to a legal trit, then shift to a base-3 digit 0..2.
    let a0: i64 = std_clamp(t0, -1, 1) + 1;
    let a1: i64 = std_clamp(t1, -1, 1) + 1;
    let a2: i64 = std_clamp(t2, -1, 1) + 1;
    // Base-3 positional encoding: 9, 3, 1.
    return a0 * 9 + a1 * 3 + a2;
}
