// ==============================================================================
// MANDELBROT — the Mandelbrot set escape-time calculator in Pure Omni
// ==============================================================================
//
// The Mandelbrot set: the set of complex numbers c for which the iteration
// z = z^2 + c, starting from z = 0, stays bounded forever. This program
// counts how many iterations it takes a point to escape (or reports that
// it never does, up to the step limit). It is the classic fractal — the
// same calculation that draws the famous infinite coastline.
//
//   main(re, im, max_iter) -> iterations
//
//   re, im   : the point c = re/100 + i*im/100, each clamped to [-200, 200]
//              (so the point lives in the square [-2, 2] x [-2, 2]).
//   max_iter : the step limit, clamped to [1, 500].
//
//   iterations : how many steps until |z| > 2 (escape), or max_iter if
//                it never escapes. A point that returns max_iter is in
//                (or very near) the Mandelbrot set.
//
// Fixed-point arithmetic, scale 100: zr and zi are the real and imaginary
// parts times 100. Each step is zr_new = (zr^2 - zi^2)/100 + re and
// zi_new = (2*zr*zi)/100 + im. Escape is zr^2 + zi^2 > 40000 (that is,
// |z|^2 > 4). The loop condition encodes a conjunction without a boolean
// AND, the same product trick as the Collatz program: f * (max_iter -
// iter) is nonzero exactly while the point is still inside AND steps
// remain, where f is 1 inside and 0 outside.
//
// Examples (run with: omnic run mandelbrot.omni <re> <im> <max_iter>):
//   main(0, 0, 100)     -> 100  (c=0, never escapes, in the set)
//   main(200, 0, 100)   -> 2    (c=2, escapes almost immediately)
//   main(100, 0, 100)   -> 3    (c=1, escapes in 3 steps)
//   main(-100, 0, 100)  -> 100  (c=-1, oscillates 0 -> -1 -> 0, in the set)
//   main(50, 50, 100)   -> 5    (c=0.5+0.5i, escapes in 5 steps)
// ==============================================================================

include "std/math.omni";
include "std/trit.omni";

#[strict]
#[cap(AI)]
#[step_budget(100000)]
#[mem_budget(8192)]
fn main(re: i64, im: i64, max_iter: i64) -> i64 {
    let cr: i64 = std_clamp(re, -200, 200);
    let ci: i64 = std_clamp(im, -200, 200);
    let budget: i64 = std_clamp(max_iter, 1, 500);
    let zr: i64 = 0;
    let zi: i64 = 0;
    // f is 1 while the point is inside (|z| <= 2), 0 once it escapes.
    let f: i64 = 1;
    let iter: i64 = 0;
    // Loop while inside AND steps remain.
    while f * (budget - iter) <=> 0 {
        // One Mandelbrot step: z = z^2 + c, in fixed point (scale 100).
        let zr2: i64 = zr * zr;
        let zi2: i64 = zi * zi;
        let nzr: i64 = (zr2 - zi2) / 100 + cr;
        let nzi: i64 = (2 * zr * zi) / 100 + ci;
        zr = nzr;
        zi = nzi;
        // Recompute f from the new |z|^2. Escape is mag > 40000.
        let mag: i64 = zr * zr + zi * zi;
        let g: trit = egate(40000 - mag);
        f = if_pos g { 1 } else { if_neg g { 0 } else { 1 } };
        iter += 1;
    }
    return iter;
}
