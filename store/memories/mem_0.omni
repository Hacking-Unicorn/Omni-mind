// ==============================================================================
// MEM_0 — Omni-Mind store memory 0 ("greeting") (Phase 1 prototype)
// ==============================================================================
//
// A store memory is a standalone Omni program. Its main(ctx) returns the
// same packed result mem_activate returns in mind/memory.omni:
//
//   (value + 100) * 10 + (confidence + 1)
//
//   Memory 0 ("greeting") : value 42, confidence +1 -> 1422.
//   Memory 1 ("farewell") : value 99, confidence +1 -> 1992.
//   Unknown id            : value 0,  confidence 0  -> 1001.
//
// The runner (run_store.sh) activates the final node of a walk by running
// its mem file and unpacking the value as (packed / 10) - 100.
//
// ctx is reserved for future context-sensitive activation and is folded
// in as + ctx * 0, the same convention as mind/memory.omni.
// ==============================================================================

#[strict]
#[cap(AI)]
#[step_budget(24000)]
#[mem_budget(8192)]
fn main(ctx: i64) -> i64 {
    // Memory 0 ("greeting"): value 42, confidence +1.
    return (42 + 100) * 10 + (1 + 1) + ctx * 0;
}
